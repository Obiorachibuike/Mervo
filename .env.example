# ─── Core ────────────────────────────────────────────────────────────────────
# App URL used for canonical links, cookies and emails
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Database ───────────────────────────────────────────────────────────────
# Production: PostgreSQL connection string (Neon / Supabase / RDS / any Postgres)
# DATABASE_URL="postgresql://user:password@host:5432/mervo?sslmode=require"
# DIRECT_URL is used for migrations when the pooled URL cannot run DDL
# DIRECT_URL="postgresql://user:password@host:5432/mervo?sslmode=require"
#
# Leave DATABASE_URL unset to run MERVO in embedded mode (PGlite persisted to
# ./.data/pglite). Embedded mode is for local development and demos only.

# ─── Security ───────────────────────────────────────────────────────────────
# 32+ byte random strings: `openssl rand -base64 48`
AUTH_SECRET="replace-me-with-openssl-rand-base64-48"
# Used to encrypt AI provider API keys at rest (AES-256-GCM)
ENCRYPTION_KEY="replace-me-with-openssl-rand-base64-48"

# ─── AI providers (all optional — MERVO degrades to deterministic analytics) ──
AGNES_API_KEY=""
AGNES_BASE_URL="https://api.agnes.ai/v1"
OPENAI_API_KEY=""
HF_TOKEN=""

# ─── Payments (optional — enable the gateway when credentials are present) ──
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Object storage (optional) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Background jobs ────────────────────────────────────────────────────────
# Shared secret required by /api/cron/* endpoints (Vercel Cron or external scheduler)
CRON_SECRET=""
# Set to 1 to keep pg-boss style scheduling inside the Next.js runtime
JOBS_INLINE="1"
